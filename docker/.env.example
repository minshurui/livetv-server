# 复制为 docker/.env 后按需修改；不要提交真实 IP、SSH 信息或密钥。
LIVETV_IMAGE=minshurui/livetv-allinone:latest
LIVETV_DATA_DIR=../data
# 留空时，m3u 链接根据客户端请求的 Host 自动生成。
PUBLIC_HOST=
TZ=Asia/Shanghai

# 宿主机端口。若修改流端口，Compose 会自动把新端口写进 M3U。
HOST_LIVETV_PORT=8081
HOST_IPTV_UI_PORT=8080
HOST_AIO_PORT=35455
HOST_PROXY_PORT=19090
HOST_RES_PORT=35456
HOST_PY_PORT=19091

# 电视源保护：少于此频道数时不覆盖最后一次成功结果。
IPTV_MIN_CHANNELS=20
# 1=过滤正时长 EXTINF 和常见视频文件；0=允许录播/VOD。
IPTV_REJECT_VOD=1
# 逗号分隔的 URL 关键字；也可编辑 data/lnmp/applecms/iptv-blocklist.txt。
IPTV_BLOCKLIST=
